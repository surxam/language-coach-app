# ── Base de données MySQL ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=motdepasse
DB_NAME=langue_app

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# ── Serveur ─────────────────────────────────────────────────
PORT=4000

# ── IA — REQUIS pour que le coach fonctionne ────────────────

# Clé Anthropic Claude (réponses du coach + analyse de fin de session)
# Obtenez la vôtre sur : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Clé OpenAI Whisper (transcription audio speech-to-text)
# Obtenez la vôtre sur : https://platform.openai.com/api-keys
# Si absente : l'app tourne mais sans vraie transcription (mode mock).
OPENAI_API_KEY=sk-...
