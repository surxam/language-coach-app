{
  "expo": {
    "name": "Coach Conversation",
    "slug": "coach-conversation",
    "scheme": "coachconversation",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.coachconversation",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Le micro est utilisé pour vous permettre de parler à votre coach IA."
      }
    },
    "android": {
      "package": "com.example.coachconversation",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Le micro est utilisé pour vous permettre de parler à votre coach IA."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7E7E5"
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
